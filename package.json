{
  "name": "slop-or-not",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @slop-or-not/cli dev",
    "start": "bun run --filter @slop-or-not/cli start",
    "build": "bun run --workspaces --if-present build",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun test --pass-with-no-tests",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7"
  }
}
