{
  "name": "slop-or-not",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter @slop-or-not/server --filter @slop-or-not/web dev",
    "start": "bun run --filter @slop-or-not/server start",
    "build": "bun run --filter @slop-or-not/web build && bun run --filter @slop-or-not/server build",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun test apps/server/tests apps/web/tests",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "7.0.2"
  }
}
